# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3000"

# Local API. BOOT_STRICT=true refuses to start when the platform database is unreachable.
NODE_ENV="development"
PORT="3001"
BOOT_STRICT="true"

# Control plane PostgreSQL. Copy this file to .env and replace every value.
# POSTGRES_PASSWORD is used by db/docker-compose.yml.
POSTGRES_PASSWORD="lilac_dev_password"
POSTGRES_PORT="5432"
PLATFORM_ADMIN_URL="postgres://postgres:lilac_dev_password@localhost:5432/erp_platform"
PLATFORM_DATABASE_URL="postgres://lilac_platform_app:dev-app-password-change-me@localhost:5432/erp_platform"

# Optional provisioning worker connection; use a separate role with CREATEDB and CREATEROLE.
# Keep this credential out of the platform application's normal runtime configuration.
PROVISIONING_DATABASE_URL="postgresql://postgres:REPLACE_WITH_PASSWORD@localhost:5432/erp_platform"
BACKUP_DIR="storage/backups"
# Optional local-only worker mode: run the installed pg_dump from the PostgreSQL Docker container.
PG_DUMP_DOCKER_CONTAINER="lilac-postgres"

# Passwords for the least-privilege roles created by db:migrate (minimum 16 characters).
PLATFORM_APP_PASSWORD="dev-app-password-change-me"
PLATFORM_MIGRATOR_PASSWORD="dev-migrator-password-change-me"

# Required server secrets. Generate APP_SECRET with at least 32 random characters and
# KMS_LOCAL_KEY with: openssl rand -base64 32
APP_SECRET="REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS"
KMS_LOCAL_KEY="REPLACE_WITH_BASE64_32_BYTE_KEY"
