{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:web": "vite --port=3000 --host=0.0.0.0",
    "dev:api": "tsx watch server/src/index.ts",
    "dev:full": "node scripts/dev.mjs",
    "build": "vite build",
    "build:api": "esbuild server/src/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist-server/server.mjs --external:pg --external:argon2 --external:sharp --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "build:all": "npm run build && npm run build:api",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env dist-server/server.mjs",
    "clean": "node scripts/clean.mjs",
    "lint": "tsc --noEmit",
    "typecheck:api": "tsc -p tsconfig.server.json --noEmit",
    "typecheck": "npm run lint && npm run typecheck:api",
    "db:up": "docker compose --env-file .env -f db/docker-compose.yml up -d --wait postgres",
    "db:down": "docker compose --env-file .env -f db/docker-compose.yml down",
    "db:migrate": "tsx server/src/scripts/migrate-platform.ts",
    "db:migrate:tenant": "tsx server/src/scripts/migrate-tenant.ts",
    "db:provision:setup": "tsx server/src/scripts/setup-provisioning-role.ts",
    "db:provision:smoke": "tsx server/src/scripts/provisioning-smoke.ts",
    "db:provision:worker": "tsx server/src/scripts/provision-worker.ts",
    "db:seed": "tsx server/src/scripts/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "test": "tsx --test --test-concurrency=1 \"server/tests/*.test.ts\" \"src/data/*.test.ts\"",
    "security:audit": "npm audit --omit=dev",
    "security:scan": "node scripts/secret-scan.mjs",
    "security:gates": "npm run security:audit && npm run security:scan"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "argon2": "^0.45.1",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "glisse": "^0.6.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.14",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.11.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "vite": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "axe-core": "^4.14.1",
    "esbuild": "^0.28.2",
    "playwright": "^1.65.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
